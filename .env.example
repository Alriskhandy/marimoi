APP_NAME=Marimoi
APP_ENV=local
METADATA_WAJIB_SEJAK=2026-10-01
APP_KEY=base64:0foNQNurdvfCmknACiR/uuVherTb5cHtz6v/b5Z67KM=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://marimoi.heartware-digital.my.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=marimoi
DB_USERNAME=marimoi_user
DB_PASSWORD=LaravelStrong2024!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email aspirasi & feedback. Production: MAIL_MAILER=smtp, isi kredensial SMTP,
# dan pastikan APP_URL benar (dipakai untuk link di email). Email dikirim lewat
# antrian (QUEUE_CONNECTION=database) -> wajib ada worker: php artisan queue:work --tries=3
# Worker membaca config & kode hanya saat start: setiap kali .env/kode berubah, jalankan
# `php artisan queue:restart` (worker berhenti aman; Supervisor/terminal menyalakannya lagi).
# Port 465 -> MAIL_SCHEME=smtps, port 587 -> MAIL_SCHEME=smtp (STARTTLS otomatis).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Opsional: kotak masuk petugas untuk balasan warga
MAIL_REPLY_TO_ADDRESS=
# Penerima notifikasi aspirasi/feedback baru, pisahkan dengan koma.
# Kosong = dikirim ke semua super-admin aktif.
MAIL_ADMIN_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"